# Optional. Pins the allowed origin for state-changing requests (CSRF defence).
# Strongly recommended in production, e.g. https://your-domain.com
FRONTEND_ORIGIN="https://yourdomain.com"

# How the client address used for rate limiting is determined.
#
# Unset (the default) = forwarding headers are IGNORED. Requests with no resolvable
# address share a single rate-limit bucket, so a client cannot gain fresh attempts by
# sending a fake X-Forwarded-For. This is the safe setting for a single-admin site.
#
# Set to "true" ONLY when a reverse proxy or CDN sits in front of this app and
# OVERWRITES X-Forwarded-For with the genuine client IP. If the app is reachable
# directly, setting this to "true" lets an attacker rotate the header and bypass limits.
# TRUST_PROXY_HEADERS="false"
# TRUST_PROXY_HEADERS="true"

# Required only for the guarded LAN scripts (`npm run dev:lan` / `npm run start:lan`).
# Without this the script refuses to bind 0.0.0.0. Never expose a dev server publicly.
# ALLOW_PUBLIC_DEV="1"

